<% content_for :title, "Users" %>

<div class="page-header">
  <div>
    <h1 class="page-title">Users</h1>
    <p class="page-subtitle">Manage system users and their account information</p>
  </div>
  <div>
    <%= link_to "+ New User", new_user_path, class: "btn btn-primary" %>
  </div>
</div>

<% if @users.any? %>
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Email</th>
          <th>Age</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr id="<%= dom_id(user) %>">
            <td><strong>#<%= user.id %></strong></td>
            <td><%= user.name %></td>
            <td><%= user.email %></td>
            <td><%= user.age.present? ? user.age : "—" %></td>
            <td>
              <div class="table-actions">
                <%= link_to "View", user_path(user), class: "btn btn-secondary btn-sm" %>
                <%= link_to "Edit", edit_user_path(user), class: "btn btn-secondary btn-sm" %>
                <%= button_to "Delete", user_path(user), method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{user.name}?" }, class: "btn btn-danger btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <h2 class="empty-state-title">No users found</h2>
    <p class="empty-state-text">Get started by creating the first user in the system.</p>
    <%= link_to "Create First User", new_user_path, class: "btn btn-primary" %>
  </div>
<% end %>
